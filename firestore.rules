rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dailyChallenges/{dateKey} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
          'challengeId', 'dateKey', 'timeZone', 'verses', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'challengeId', 'dateKey', 'timeZone', 'verses', 'createdAt'
        ])
        && request.resource.data.challengeId == 'pacific-' + dateKey
        && request.resource.data.dateKey == dateKey
        && dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.timeZone == 'America/Los_Angeles'
        && request.resource.data.verses is list
        && request.resource.data.verses.size() == 10
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null
        && scoreId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'score', 'correct', 'total', 'accuracy', 'date', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'score', 'correct', 'total', 'accuracy', 'date', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.total is int
        && request.resource.data.total == 10
        && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.accuracy is int
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
